# Copy this file to .env (in this backend/ directory) and fill in real values.
# Never commit .env. Spot Testnet and Futures Testnet are separate Binance testnets
# with separate keys - generate each from its own testnet portal.

BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_API_SECRET=

BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=

# Mainnet keys are not needed until Phase 8 - leave blank for now.
BINANCE_SPOT_MAINNET_API_KEY=
BINANCE_SPOT_MAINNET_API_SECRET=
BINANCE_FUTURES_MAINNET_API_KEY=
BINANCE_FUTURES_MAINNET_API_SECRET=
